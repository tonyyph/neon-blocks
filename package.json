{
  "name": "neon-blocks",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo-google-fonts/architects-daughter": "^0.4.1",
    "@expo-google-fonts/baloo-2": "^0.4.2",
    "@expo-google-fonts/chakra-petch": "^0.4.1",
    "@expo-google-fonts/cinzel": "^0.4.2",
    "@expo-google-fonts/cormorant-garamond": "^0.4.1",
    "@expo-google-fonts/orbitron": "^0.4.2",
    "@expo-google-fonts/share-tech-mono": "^0.4.1",
    "@expo-google-fonts/unifrakturmaguntia": "^0.4.1",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.26",
    "expo-asset": "~57.0.18",
    "expo-audio": "~57.0.5",
    "expo-constants": "~57.0.20",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linear-gradient": "~57.0.2",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-view-shot": "5.1.0",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.4",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.5",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "verify": "pnpm typecheck && pnpm lint && pnpm test",
    "assets": "node tools/generate-assets.js",
    "sounds": "node tools/generate-sounds.js",
    "eas:whoami": "sh tools/eas.sh whoami",
    "eas:builds": "sh tools/eas.sh build:list --limit 10",
    "eas:credentials": "sh tools/eas.sh credentials",
    "build:ios": "sh tools/eas.sh build --platform ios --profile production --non-interactive --wait",
    "submit:ios": "sh tools/eas.sh submit --platform ios --profile production --latest --non-interactive --wait",
    "release:ios": "pnpm verify && pnpm build:ios && pnpm submit:ios",
    "asc:app-id": "node tools/asc-app-id.js",
    "ios:release": "expo run:ios --configuration Release"
  },
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/__fixtures__/"
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ]
  }
}
